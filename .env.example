# Copy this file to `.env` and fill in your real values.
# `.env` is gitignored - never commit real tokens.

ORIGIN_LAT=35.736000000000004
ORIGIN_LONG=51.440000000000055

DEST_LAT=35.71062963544567
DEST_LONG=51.34362036878247

# Interval between price checks, in seconds (default: 600 = 10 minutes)
INTERVAL_SECONDS=600

# Get these by logging into app.tapsi.cab / app.snapp.taxi in your browser
# and copying the cookies / Authorization header from a network request.
# They expire periodically and need to be refreshed the same way.
TAPSI_ACCESS_TOKEN=
TAPSI_REFRESH_TOKEN=
SNAPP_ACCESS_TOKEN=
